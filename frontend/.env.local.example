# Copy this file to .env.local and fill in real values. Never commit .env.local.
#
# Next.js only exposes env vars prefixed NEXT_PUBLIC_ to the browser — every
# value here ends up in client-side JS, so NONE of these may ever be a
# secret. In particular: never put SUPABASE_SERVICE_ROLE_KEY here (or
# anywhere in this frontend) — that key is backend-only, see backend/.env.example.

# FastAPI backend base URL (no trailing slash) — see backend/.env.example's
# API_V1_STR; the API client appends /api/v1 itself.
NEXT_PUBLIC_API_URL=http://localhost:8000

# WebSocket base URL for the live-tracking socket (WS /api/v1/ws/trips/{trip_id}).
# ws:// in local dev, wss:// in any real deployment (mixed content is
# blocked by browsers on an https:// page otherwise).
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Same Supabase project the backend's SUPABASE_URL/JWT_SECRET point at —
# the frontend authenticates directly against Supabase Auth (see
# lib/supabase/client.ts) and hands the resulting access token to FastAPI.
NEXT_PUBLIC_SUPABASE_URL=
# The anon/public key from Settings > API — safe for the browser by design
# (Supabase enforces access via Row Level Security, not by keeping this
# secret). NOT the service role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps Platform — browser-restricted key (safe to expose to the browser).
# Required APIs to enable in your Google Cloud project:
#   • Maps JavaScript API   (map tiles & markers)
#   • Places API (New)      (destination autocomplete / text search)
#   • Routes API            (route calculation & travel times)
#
# Cost notes (see https://mapsplatform.google.com/pricing/):
#   • $200 free monthly credit covers ~28 000 Dynamic Map loads, ~70 000 Place
#     Text Search requests, and ~40 000 Routes API calls per month.
#   • Debounce destination search calls (already done: 400 ms) to stay within limits.
#   • Restrict this key to your domain and only the 3 APIs above.
#
# When this variable is empty the app falls back to:
#   • OpenStreetMap (Leaflet) → replaced; map shows a configuration banner.
#   • Nominatim              → destination search fallback.
#   • OSRM                   → route calculation fallback.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
